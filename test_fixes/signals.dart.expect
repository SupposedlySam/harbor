// The signal names' `dart fix` transforms (lib/fix_data/signals.yaml): flares were signals through
// 0.3.0. A call through an old name is renamed, and then takes the placement transforms too.

import 'package:flutter/widgets.dart';
import 'package:harbor/harbor.dart';

void signals(BuildContext context, HarborAnchor anchor) {
  HarborToasts.show(context, slot: HarborToastSlot.low, target: HarborToastTarget.root, builder: (_) => const SizedBox());
  final HarborToastEntry entry = HarborToasts.show(context, placement: const HarborAligned(alignment: Alignment.bottomCenter), builder: (_) => const SizedBox());
  HarborToasts.show(context, placement: HarborAnchored(anchor), builder: (_) => const SizedBox());
  entry.closed.then((final HarborToastClosedReason reason) => reason);
  final HarborToastTransitionBuilder fade = (context, animation, child) => FadeTransition(opacity: animation, child: child);
  fade(context, const AlwaysStoppedAnimation<double>(1), const SizedBox());
}
