// The signal names' `dart fix` transforms (lib/fix_data/signals.yaml): flares were signals through
// 0.3.0. A call through an old name is renamed, and then takes the placement transforms too.

import 'package:flutter/widgets.dart';
import 'package:harbor/harbor.dart';

void signals(BuildContext context, HarborAnchor anchor) {
  HarborFlares.raise(context, slot: HarborFlareSlot.low, target: HarborFlareTarget.sea, builder: (_) => const SizedBox());
  final HarborFlareEntry entry = HarborFlares.raise(context, placement: const HarborAligned(alignment: Alignment.bottomCenter), builder: (_) => const SizedBox());
  HarborFlares.raise(context, placement: HarborAnchored(anchor), builder: (_) => const SizedBox());
  entry.closed.then((final HarborFlareClosedReason reason) => reason);
  final HarborFlareTransitionBuilder fade = (context, animation, child) => FadeTransition(opacity: animation, child: child);
  fade(context, const AlwaysStoppedAnimation<double>(1), const SizedBox());
}
