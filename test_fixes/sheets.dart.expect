// The sheets step's transforms (lib/fix_data/sheets.yaml): this file is written against the barrier
// parameters of 0.9 (a sheet's HarborSheetBarrier and isDismissible, barrierColor, barrierLabel and
// barrierOnTapHint; a dialog's barrierColor, barrierDismissible and barrierLabel; a float's modal,
// barrierColor and barrierLabel) and a sheet's header and footer knobs. sheets.dart.expect is what
// `dart fix --apply` makes of it, including what it leaves alone because a rewrite could break code
// that compiles (tool/fix_data/sheets.dart says why for each).

import 'package:flutter/widgets.dart';
import 'package:harbor/harbor.dart';

const Color tint = Color(0x66000000);

void sheets(BuildContext context, bool answered, String label, HarborSheetBarrier barrier) {
  // No barrier, alone, is left: HarborSheetBarrier.none rewritten everywhere breaks a variable typed
  // with the enum. It still compiles, the enum's values being barriers.
  showHarborSheet<void>(context, barrier: HarborSheetBarrier.none, builder: (_) => const SizedBox());
  // Each loose argument, alone and together, becomes a field of a dimmed barrier.
  showHarborSheet<void>(context, barrier: const HarborBarrier.dimmed(dismissible: false), builder: (_) => const SizedBox());
  showHarborSheet<void>(context, barrier: const HarborBarrier.dimmed(color: tint), builder: (_) => const SizedBox());
  showHarborSheet<void>(context, barrier: HarborBarrier.dimmed(label: label), builder: (_) => const SizedBox());
  showHarborSheet<void>(context, barrier: const HarborBarrier.dimmed(onTapHint: 'close the sheet'), builder: (_) => const SizedBox());
  showHarborSheet<void>(
    context, barrier: HarborBarrier.dimmed(color: tint, dismissible: answered, label: label, onTapHint: 'close the sheet'),
    builder: (_) => const SizedBox(),
  );
  // With the old enum: dismissible is dimmed, clear is clear and drops the colour it never used,
  // and none drops everything, which did nothing.
  showHarborSheet<void>(
    context, barrier: HarborBarrier.dimmed(label: label),
    builder: (_) => const SizedBox(),
  );
  showHarborSheet<void>(
    context, barrier: const HarborBarrier.clear(dismissible: false),
    builder: (_) => const SizedBox(),
  );
  showHarborSheet<void>(context, barrier: const HarborBarrier.clear(), builder: (_) => const SizedBox());
  showHarborSheet<void>(
    context, barrier: HarborBarrier.none,
    builder: (_) => const SizedBox(),
  );
  // A barrier given by a variable is left as it is, still compiling: which barrier it is depends on
  // its value.
  showHarborSheet<void>(context, barrier: barrier, isDismissible: false, builder: (_) => const SizedBox());
  // Through the 0.8 names too: the rename's transforms run on the way.
  showHarborSheet<void>(
    context, barrier: const HarborBarrier.dimmed(dismissible: false),
    coversPage: true,
    reachesTop: true,
    builder: (_) => const SizedBox(),
  );
}

void dialogs(BuildContext context, String label) {
  showHarborDialog<void>(context, barrier: const HarborBarrier.dimmed(dismissible: false), builder: (_) => const SizedBox());
  showHarborDialog<void>(context, barrier: HarborBarrier.dimmed(color: tint, label: label), builder: (_) => const SizedBox());
  showHarborDialog<void>(
    context, barrier: HarborBarrier.dimmed(color: tint, dismissible: false, label: label),
    builder: (_) => const SizedBox(),
  );
  HarborDialogRoute<void>(context: context, builder: (_) => const SizedBox(), barrier: const HarborBarrier.dimmed(dismissible: false));
  HarborDialogRoute<void>(context: context, inheritRoom: true, barrier: HarborBarrier.dimmed(label: label), builder: (_) => const SizedBox());
  // A route's barrierColor: null was a barrier with no colour, a clear one, with whatever else the call
  // gave. Any other colour is left for you: the parameter is a Color?, and a fix compares text.
  HarborDialogRoute<void>(context: context, builder: (_) => const SizedBox(), barrier: const HarborBarrier.clear());
  HarborDialogRoute<void>(context: context, barrier: const HarborBarrier.clear(dismissible: false), builder: (_) => const SizedBox());
  HarborDialogRoute<void>(
    context: context,
    barrier: HarborBarrier.clear(dismissible: false, label: label),
    builder: (_) => const SizedBox(),
  );
  HarborDialogRoute<void>(context: context, barrierColor: tint, barrierDismissible: false, builder: (_) => const SizedBox());
}

void floats(VoidCallback close, HarborAnchor anchor, bool open) {
  // modal: true is a clear barrier, or a dimmed one with a barrierColor.
  HarborFloat(onDismiss: close, child: const SizedBox(), barrier: const HarborBarrier.clear());
  HarborFloat(onDismiss: close, child: const SizedBox(), barrier: const HarborBarrier.clear(label: 'Close menu'));
  HarborFloat(onDismiss: close, child: const SizedBox(), barrier: const HarborBarrier.dimmed(color: tint));
  HarborFloat(onDismiss: close, child: const SizedBox(), barrier: const HarborBarrier.dimmed(color: tint, label: 'Close menu'));
  // modal: false, and a colour or label without modal, did nothing.
  const HarborFloat(child: SizedBox());
  const HarborFloat(child: SizedBox());
  // Through the 0.8 name, and the 0.7 anchored constructor.
  HarborFloat(onDismiss: close, child: const SizedBox(), barrier: const HarborBarrier.clear());
  HarborFloat(
    placement: HarborAnchored(anchor, side: HarborAnchorSide.above), onDismiss: close,
    child: const SizedBox(), barrier: const HarborBarrier.clear(label: 'Close menu'),
  );
  // A modal given by a variable is left as it is: whether it is a barrier depends on its value.
  HarborFloat(modal: open, onDismiss: close, child: const SizedBox());
}

void headersAndFooters() {
  const Widget title = SizedBox();
  const Widget actions = SizedBox();
  // A knob of a plain header or footer puts it in its own bar, spelled out with the sheet's defaults
  // for the knobs the call left out. Without the header or footer it belongs to, a knob did nothing,
  // and goes. (A header or footer that can be null comes out as a type error; see sheets.dart in
  // tool/fix_data/.)
  const HarborSheet(headerBar: HarborBar.overlay(edgeEffect: HarborEdgeEffect.none, debugLabel: 'sheet header', child: title), body: SizedBox());
  const HarborSheet(body: SizedBox(), footerBar: HarborBar.solid(edgeEffect: HarborEdgeEffect.hairline(), minimum: 0, keyboard: HarborKeyboardStance.rides, debugLabel: 'sheet footer', child: actions));
  const HarborSheet(
    headerBar: HarborBar.overlay(edgeEffect: HarborEdgeEffect.none, debugLabel: 'sheet header', child: title),
    footerBar: HarborBar.solid(edgeEffect: HarborEdgeEffect.none, minimum: 0, keyboard: HarborKeyboardStance.reserves, debugLabel: 'sheet footer', child: actions),
    body: SizedBox(),
  );
  HarborSheet.draggable(
    headerBar: const HarborBar.overlay(edgeEffect: HarborEdgeEffect.hairline(), debugLabel: 'sheet header', child: title),
    footerBar: const HarborBar.solid(edgeEffect: HarborEdgeEffect.hairline(), minimum: 16.0, keyboard: HarborKeyboardStance.stays, debugLabel: 'sheet footer', child: actions),
    builder: (context, controller) => const SizedBox(),
  );
  const HarborSheet(body: SizedBox());
  // The 0.8 names are renamed to the knobs on the way.
  const HarborSheet(
    headerBar: HarborBar.overlay(edgeEffect: HarborEdgeEffect.none, debugLabel: 'sheet header', child: title),
    footerBar: HarborBar.solid(edgeEffect: HarborEdgeEffect.hairline(), minimum: 16.0, keyboard: HarborKeyboardStance.stays, debugLabel: 'sheet footer', child: actions),
    body: SizedBox(),
  );
}
