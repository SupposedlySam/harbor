// The rename's enum value transforms (lib/fix_data/rename.yaml, 0.9.0): every renamed value, through
// the old type name and the new one, in an expression and in a switch.

import 'package:harbor/harbor.dart';

String values(final HarborKeyboardStance stance, final HarborKeyboardPhase phase) {
  final List<Object> all = <Object>[
    HarborKeyboardStance.rides,
    HarborKeyboardStance.stays,
    HarborKeyboardStance.reserves,
    HarborKeyboardStance.rides,
    HarborKeyboardPhase.hidden,
    HarborKeyboardPhase.opening,
    HarborKeyboardPhase.shown,
    HarborKeyboardPhase.closing,
    HarborBarKind.overlay,
    HarborBarKind.solid,
    HarborBarKind.solid,
    HarborToastTarget.root,
    HarborToastClosedReason.hide,
    HarborRoomAspect.systemEdges,
    HarborRoomAspect.bars,
    HarborRest.fadeEnd,
    HarborRest.barFace,
  ];
  final String a = switch (stance) {
    HarborKeyboardStance.rides => 'rides',
    HarborKeyboardStance.stays => 'stays',
    HarborKeyboardStance.reserves => 'reserves',
  };
  switch (phase) {
    case HarborKeyboardPhase.hidden:
    case HarborKeyboardPhase.opening:
      return a;
    case HarborKeyboardPhase.shown || HarborKeyboardPhase.closing:
      return '$all';
  }
}
