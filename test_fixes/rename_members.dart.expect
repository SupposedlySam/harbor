// The rename's member transforms (lib/fix_data/rename.yaml, 0.9.0): every renamed getter, method and
// static, read through an old type name or a new one, and a tear-off of each kind.

import 'package:flutter/widgets.dart';
import 'package:harbor/harbor.dart';

void reads(
  BuildContext context,
  HarborFrame frame,
  HarborRoot sea,
  HarborBar dock,
  HarborBarRecord record,
  HarborAttachedBar pontoon,
  HarborAttachedBarHandle handle,
  HarborSystemEdges edges,
  HarborKeyboardState keyboard,
  HarborKeyboardSpace space,
  HarborRoomData room,
  HarborHandled handled,
  HarborLayoutRecord layout,
  HarborController controller,
  HarborClear clear,
  HarborScrollView scroll,
  HarborSliverClear sliver,
  HarborEdgeEffect fade,
  HarborFadeBand band,
  HarborFadeMask mask,
  HarborPopover popover,
  HarborToastEntry toast,
  HarborFrameRegistry registry,
  HarborSheet sheet,
  HarborDialogRoute<void> dialog,
  HarborInspectorEntry entry,
  HarborScaledScreen scaled,
) {
  <Object?>[frame.floats, frame.systemEdges, frame.isPage, frame.bodyClearsKeyboard, frame.edgeEffectPainter, frame.barHinge, sea.systemEdges];
  <Object?>[dock.edgeEffect, dock.keyboard, dock.systemEdges, dock.effectiveSystemEdges, record.keyboard, pontoon.bar, handle.bar];
  <Object?>[edges.ignoresKeyboard, keyboard.settledHeight, keyboard.settledHeightIsEstimate, keyboard.isShown, space.showsChildWithKeyboard];
  <Object?>[room.systemEdges, room.systemEdgesSteady, room.bars, room.barsResting, room.fadeBands, room.hasBars, room.fadeBandsPainted];
  <Object?>[room.handled(HarborEdge.vertical), room.fadeBandOf(HarborEdge.top), handled.clearsKeyboard, handled.clearsBars];
  <Object?>[layout.room, layout.bars, layout.keyboard];
  // dockedEdges, the breakwater readings, flares, withDockOn and pontoonsOn are left on their 0.8 names:
  // what they were renamed to went @internal after 0.9.1 (tool/fix_data/rename.dart).
  <Object?>[controller.room, controller.roomInGlobal(), controller.registry, controller.isPage, controller.dockedEdges];
  <Object?>[controller.breakwaterTopsInGlobal, controller.breakwaterCoverage, controller.breakwaterChanges, controller.flares];
  <Object?>[clear.clearsKeyboard, clear.rowInsets, clear.padding, scroll.rowInsets, scroll.clearsKeyboard, scroll.edgeEffects, scroll.startsUnderBars];
  <Object?>[sliver.clearsKeyboard, fade.faceOpacity, band.barFace, band.fadeEnd, band.faceOpacity, mask.bands, mask.faceOpacity];
  <Object?>[popover.popoverBuilder, registry.frames, registry.root];
  <Object?>[sheet.headerEdgeEffect, sheet.footerEdgeEffect, sheet.footerKeyboard, sheet.clearsTopSystemEdge, sheet.bodyClearsKeyboard, dialog.inheritRoom];
  <Object?>[entry.room, entry.bars, entry.keyboard, scaled.systemEdges];
}

void calls(BuildContext context, HarborController controller, HarborToastEntry toast) {
  HarborKeyboard.isShownOf(context);
  HarborRoom.steadySystemEdgeOf(context, HarborEdge.bottom);
  HarborRoom.barFaceOf(context, HarborEdge.top);
  HarborFadeMask.alphaFade(context, const <HarborEdge, HarborFadeBand>{}, const SizedBox());
  controller.withDockOn(HarborEdge.top);
  final HarborClaim claim = controller.hideBar(HarborEdge.bottom, state: HarborBarState.dark);
  final HarborAttachedBarHandle handle = controller.attachBar(HarborEdge.bottom, const HarborBar.reserve(extent: 0));
  controller.updateAttachedBar(handle, HarborEdge.top, const HarborBar.reserve(extent: 0));
  controller.pontoonsOn(HarborEdge.top);
  controller.detachBar(handle);
  controller.addPageCover(ValueNotifier<double>(0)).remove();
  controller.addPageCoverEdge(ValueNotifier<double>(0)).remove();
  toast.hide();
  claim.release();
}

void tearOffs(BuildContext context) {
  final bool Function(BuildContext) isIn = HarborKeyboard.isShownOf;
  final HarborToastEntry Function(BuildContext, {required WidgetBuilder builder}) show = HarborToasts.show;
  final void Function({HarborToastClosedReason reason}) Function(HarborToastEntry) lower =
      (final HarborToastEntry e) => e.hide;
  <Object?>[isIn, show, lower];
}

// The same reads through implicit `this`, inside an extension on each type (#143): a member read with no
// target is matched by its declaring type rather than by a target's type. Against 1.0, which removed the
// old getters, a getter read this way is left as it is (no data-driven fix for it as undefined); a
// method called this way is still renamed. On 0.10.3 both migrate. jump_to_1_0.dart has the case.
extension Implicit on HarborFrame {
  List<Object?> get reads => <Object?>[buoys, coast, newPort, bodyClearsTide, wakePainter, dockHinge];
}
extension ImplicitSea on HarborRoot {
  List<Object?> get reads => <Object?>[coast];
}
extension ImplicitDock on HarborBar {
  List<Object?> get reads => <Object?>[wake, tide, coast, effectiveCoast];
}
extension ImplicitDockRecord on HarborBarRecord {
  List<Object?> get reads => <Object?>[tide];
}
extension ImplicitPontoon on HarborAttachedBar {
  List<Object?> get reads => <Object?>[dock];
}
extension ImplicitPontoonHandle on HarborAttachedBarHandle {
  List<Object?> get reads => <Object?>[dock];
}
extension ImplicitCoast on HarborSystemEdges {
  List<Object?> get reads => <Object?>[calmTide];
}
extension ImplicitTideState on HarborKeyboardState {
  List<Object?> get reads => <Object?>[highWater, highWaterIsEstimate, isIn];
}
extension ImplicitDryDock on HarborKeyboardSpace {
  List<Object?> get reads => <Object?>[showsChildAtHighTide];
}
extension ImplicitWatersData on HarborRoomData {
  List<Object?> get reads => <Object?>[coast, coastSteady, docks, docksResting, wakes, hasDocks, wakesPainted, handled(HarborEdge.vertical), fadeBandOf(HarborEdge.top)];
}
extension ImplicitCastOff on HarborHandled {
  List<Object?> get reads => <Object?>[tide, docks];
}
extension ImplicitLayoutRecord on HarborLayoutRecord {
  List<Object?> get reads => <Object?>[clearWater, docks, tide];
}
extension ImplicitController on HarborController {
  List<Object?> get reads => <Object?>[clearWater, roomInGlobal(), fleet, isPort, dockedEdges, breakwaterTopsInGlobal, breakwaterCoverage, breakwaterChanges, flares];

  void calls() {
    withDockOn(HarborEdge.top);
    final HarborClaim claim = hideBar(HarborEdge.bottom, state: HarborBarState.dark);
    final HarborAttachedBarHandle handle = attachBar(HarborEdge.bottom, const HarborBar.reserve(extent: 0));
    updateAttachedBar(handle, HarborEdge.top, const HarborBar.reserve(extent: 0));
    pontoonsOn(HarborEdge.top);
    detachBar(handle);
    addPageCover(ValueNotifier<double>(0)).remove();
    addPageCoverEdge(ValueNotifier<double>(0)).remove();
    claim.release();
  }
}
extension ImplicitMoored on HarborClear {
  List<Object?> get reads => <Object?>[tide, mooringLine, extra];
}
extension ImplicitFairway on HarborScrollView {
  List<Object?> get reads => <Object?>[mooringLine, tide, wake, startsInOpenWater];
}
extension ImplicitFairwaySliver on HarborSliverClear {
  List<Object?> get reads => <Object?>[tide];
}
extension ImplicitWake on HarborEdgeEffect {
  List<Object?> get reads => <Object?>[dockOpacity];
}
extension ImplicitWakeBand on HarborFadeBand {
  List<Object?> get reads => <Object?>[dockEdge, wakeEnd, dockOpacity];
}
extension ImplicitWakeMask on HarborFadeMask {
  List<Object?> get reads => <Object?>[wakes, dockOpacity];
}
extension ImplicitPortalBuoy on HarborPopover {
  List<Object?> get reads => <Object?>[buoyBuilder];
}
extension ImplicitFlareEntry on HarborToastEntry {
  void calls() {
    hide();
  }
}
extension ImplicitFleet on HarborFrameRegistry {
  List<Object?> get reads => <Object?>[harbors, sea];
}
extension ImplicitSheet on HarborSheet {
  List<Object?> get reads => <Object?>[headerWake, footerWake, footerTide, clearsTopCoast, bodyClearsTide];
}
extension ImplicitDialogRoute on HarborDialogRoute<void> {
  List<Object?> get reads => <Object?>[inheritClearWater];
}
extension ImplicitChartEntry on HarborInspectorEntry {
  List<Object?> get reads => <Object?>[clearWater, docks, tide];
}
extension ImplicitScaleModel on HarborScaledScreen {
  List<Object?> get reads => <Object?>[coast];
}
