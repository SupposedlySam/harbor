// The `bars:` transforms (lib/fix_data/bars.yaml): this file is written against `clear:`, deprecated
// in 0.8.0 and removed in 0.9.0, and against 0.8.0's `bars:`, renamed `clearsBars:` in 0.9.0.
// bars.dart.expect is what `dart fix --apply` makes of it: the rename's transforms (rename.yaml)
// take the old names to the new ones as it goes.

import 'package:flutter/widgets.dart';
import 'package:harbor/harbor.dart';

void moored(BuildContext context) {
  // The coast alone becomes clearsBars: false; everything, the default, goes.
  const HarborClear(clearsBars: false, child: SizedBox());
  const HarborClear(child: SizedBox());
  const HarborClear(clearsBars: false, edges: {HarborEdge.top}, clearsKeyboard: false, child: SizedBox());
  HarborClear.clearanceOf(context, clearsBars: false);
  HarborClear.clearanceOf(context, edges: HarborEdge.vertical);
}

void both(BuildContext context, bool b) {
  // 0.8 allowed both: bars && clear != coast. With coast the result is false whatever bars says,
  // so both go and clearsBars: false is written once; with everything, bars stands, renamed.
  const HarborClear(clearsBars: false, child: SizedBox());
  const HarborClear(clearsBars: false, child: SizedBox());
  HarborClear(clearsBars: b, child: const SizedBox());
  const HarborScrollView(clearsBars: false, slivers: <Widget>[]);
  HarborScrollView.paddingOf(context, clearsBars: b);
  const HarborSliverClear(clearsBars: false, sliver: SliverToBoxAdapter());
  // The same calls as dart fix sees them when rename.yaml runs first (the order Linux picked in #163's
  // CI): bars: is already clearsBars:, and the coast branch must still leave only one.
  const HarborClear(clearsBars: false, child: SizedBox());
  HarborClear.clearanceOf(context, clearsBars: false);
}

void bars(BuildContext context, bool b) {
  // 0.8.0's bars: alone is clearsBars: in 0.9.0.
  const HarborClear(clearsBars: false, child: SizedBox());
  HarborClear.clearanceOf(context, clearsBars: b);
  const HarborScrollView(clearsBars: false, slivers: <Widget>[]);
  HarborScrollView.box(clearsBars: false, child: const SizedBox());
  HarborScrollView.paddingOf(context, clearsBars: b);
  const HarborSliverClear(clearsBars: false, sliver: SliverToBoxAdapter());
}

void fairways(BuildContext context) {
  const HarborScrollView(clearsBars: false, slivers: <Widget>[]);
  const HarborScrollView(scrollDirection: Axis.horizontal, slivers: <Widget>[]);
  HarborScrollView.box(clearsBars: false, clearsKeyboard: false, child: const SizedBox());
  HarborScrollView.paddingOf(context, clearsBars: false);
  HarborScrollView.paddingOf(context, axis: Axis.horizontal);
  const HarborSliverClear(clearsBars: false, sliver: SliverToBoxAdapter());
  const HarborSliverClear(clearLeading: false, sliver: SliverToBoxAdapter());
}
