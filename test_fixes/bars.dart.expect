// The `bars:` transforms (lib/fix_data/bars.yaml): this file is written against `clear:`, deprecated
// in 0.8.0 and removed in 0.9.0, and bars.dart.expect is what `dart fix --apply` makes of it: the
// rename's transforms (rename.yaml) take the old class names to the new ones as it goes.

import 'package:flutter/widgets.dart';
import 'package:harbor/harbor.dart';

void moored(BuildContext context) {
  // The coast alone becomes bars: false; everything, the default, goes.
  const HarborClear(bars: false, child: SizedBox());
  const HarborClear(child: SizedBox());
  const HarborClear(edges: {HarborEdge.top}, bars: false, keyboard: false, child: SizedBox());
  HarborClear.clearanceOf(context, bars: false);
  HarborClear.clearanceOf(context, edges: HarborEdge.vertical);
}

void fairways(BuildContext context) {
  const HarborScrollView(slivers: <Widget>[], bars: false);
  const HarborScrollView(scrollDirection: Axis.horizontal, slivers: <Widget>[]);
  HarborScrollView.box(keyboard: false, bars: false, child: const SizedBox());
  HarborScrollView.paddingOf(context, bars: false);
  HarborScrollView.paddingOf(context, axis: Axis.horizontal);
  const HarborSliverClear(sliver: SliverToBoxAdapter(), bars: false);
  const HarborSliverClear(clearLeading: false, sliver: SliverToBoxAdapter());
}
