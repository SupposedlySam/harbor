/harbor_test/build/
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# lamp and the owner agent's tooling: machine-local, never part of the package. lamp.lock is not
# tracked, against lamp's usual convention: harbor's only lamp dependency is llm_chat for the
# owner agent, which is machine-local anyway, so a clone has nothing to sync.
.lamp/
.game_loop/
lamp.lock
.llm_chat/
.harbor_owner/
# Claude Code: the owner agent's hooks and settings, and agent worktrees. Machine-local tooling,
# never part of the repository.
.claude/
